{
  "name": "nemfile",
  "version": "1.0.1",
  "description": "Send files, screenshots and text between your phone, iPad and computer over local Wi-Fi \u2014 no cloud, no account, no app install. One command: npx nemfile.",
  "keywords": [
    "file-transfer",
    "share-files",
    "send-files",
    "airdrop",
    "airdrop-alternative",
    "airdrop-for-windows",
    "airdrop-for-android",
    "phone-to-pc",
    "iphone-to-pc",
    "ipad-to-pc",
    "android-to-pc",
    "wifi-transfer",
    "lan",
    "local-network",
    "localhost",
    "qr-code",
    "upload",
    "drag-and-drop",
    "screenshot",
    "clipboard",
    "clipboard-sync",
    "paste",
    "text-share",
    "self-hosted",
    "no-cloud",
    "offline",
    "privacy",
    "tunnel",
    "cloudflare-tunnel",
    "express",
    "cli",
    "zero-config",
    "npx"
  ],
  "homepage": "https://github.com/quytstudio/nemfile#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quytstudio/nemfile.git"
  },
  "bugs": {
    "url": "https://github.com/quytstudio/nemfile/issues"
  },
  "license": "MIT",
  "author": "phamquyetthang <quyetthang.phucchi@gmail.com>",
  "main": "server.js",
  "bin": {
    "nemfile": "./bin/nemfile.js"
  },
  "files": [
    "bin/",
    "server.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "scripts": {
    "start": "node server.js",
    "build": "npx @yao-pkg/pkg . --compress GZip --out-path dist"
  },
  "pkg": {
    "targets": [
      "node20-linux-x64",
      "node20-macos-x64",
      "node20-win-x64"
    ],
    "assets": [
      "node_modules/qrcode/**/*",
      "node_modules/cloudflared/bin/**/*"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "cloudflared": "^0.7.3",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4"
  }
}
